{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowCloudFrontAccess",
      "Effect": "Allow",
      "Principal": {
        "Service": "cloudfront.amazonaws.com"
      },
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::{{ s3_website_bucket_name }}/*",
      "Condition": {
        "StringEquals": {
          "AWS:SourceArn": "{{ s3_website_cloudfront_arn }}"
        }
      }
    }
  ]
}
